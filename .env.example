NEXT_PUBLIC_SUPABASE_URL=copy and paste supabase project url [https://xxxxxxxxxxxx.supabase.co]
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=copy and paste supabase project "Publishable Key"

# Practice room: server-side only, never prefix with NEXT_PUBLIC_.
# Without a key the UI still runs, using the scripted fallback replies in lib/ui/scenarios.ts.
ANTHROPIC_API_KEY=

# Optional: override the model the personas run on (default claude-sonnet-5-5).
# ANTHROPIC_MODEL=

# Optional: where the "retake quiz" link in the sidebar goes.
# NEXT_PUBLIC_QUIZ_URL=
