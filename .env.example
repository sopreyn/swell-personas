NEXT_PUBLIC_SUPABASE_URL=copy and paste supabase project url [https://xxxxxxxxxxxx.supabase.co]
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=copy and paste supabase project "Publishable Key"
# Optional. Without a key the Practice Room falls back to scripted replies so the UI still works locally.
ANTHROPIC_API_KEY=copy and paste your Anthropic API key
# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5
